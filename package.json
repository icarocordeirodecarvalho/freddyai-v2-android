{
  "name": "freddyai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "FreddyAI - assistente pessoal com personalidade do Glamrock Freddy",
  "scripts": {
    "dev": "node scripts/copy-models.mjs && vite --host",
    "build": "node scripts/copy-models.mjs && vite build",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/patch-android.mjs",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@vladmandic/face-api": "^1.7.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^6.0.0"
  }
}
